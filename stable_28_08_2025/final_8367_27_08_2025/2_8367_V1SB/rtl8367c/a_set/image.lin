BankArea (0x004000, 0x00FFFF)
;NOOVERLAY
;DISABLEWARNING (16)
;IBANKING (96H)
IXREF
OVERLAY(?PR?LWPS_API_INIT?LWPS_API                 ~  ?PR?_?TCP_HANDLER_CONNECT_FUNC?LWPS_API,
        ?PR?_TCP_STATE_UPDATE?TCP                  !  ?PR?_?TCP_HANDLER_CONNECT_FUNC?LWPS_API)
OVERLAY(?PR?LWPS_API_INIT?LWPS_API                 ~  ?PR?_?TCP_HANDLER_DISCONNECT_FUNC?LWPS_API,
        ?PR?_TCP_STATE_UPDATE?TCP                  !  ?PR?_?TCP_HANDLER_DISCONNECT_FUNC?LWPS_API)
OVERLAY(?PR?LWPS_API_INIT?LWPS_API                 ~  ?PR?_?TCP_HANDLER_RECV_FUNC?LWPS_API,
        ?PR?_TCP_UP_HANDLE_IP?TCP                  !  ?PR?_?TCP_HANDLER_RECV_FUNC?LWPS_API)
        
OVERLAY(?PR?LWPS_API_INIT?LWPS_API                 ~  ?PR?_?UDP_HANDLER_RECVFROM_FUNC?LWPS_API,
        ?PR?_UDP_UP_HANDLE_IP?UDP                  !  ?PR?_?UDP_HANDLER_RECVFROM_FUNC?LWPS_API)
        
OVERLAY(?PR?HTTPD_INIT?HTTPD                       ~  ?PR?_?LWPS_HTTPD_CONNECT?HTTPD,
        ?PR?_?TCP_HANDLER_CONNECT_FUNC?LWPS_API    !  ?PR?_?LWPS_HTTPD_CONNECT?HTTPD)
OVERLAY(?PR?HTTPD_INIT?HTTPD                       ~  ?PR?_?LWPS_HTTPD_DISCONNECT?HTTPD,
        ?PR?_?TCP_HANDLER_DISCONNECT_FUNC?LWPS_API !  ?PR?_?LWPS_HTTPD_DISCONNECT?HTTPD)
OVERLAY(?PR?HTTPD_INIT?HTTPD                       ~  ?PR?_?LWPS_HTTPD_RECEIVE?HTTPD,
        ?PR?_?TCP_HANDLER_RECV_FUNC?LWPS_API       !  ?PR?_?LWPS_HTTPD_RECEIVE?HTTPD)
        
OVERLAY(?PR?_TCP_STATE_UPDATE?TCP                  !  ?PR?_?LWPS_HTTPD_CONNECT?HTTPD,
        ?PR?_TCP_STATE_UPDATE?TCP                  !  ?PR?_?LWPS_HTTPD_DISCONNECT?HTTPD)
        
;DHCPC OVERLAY
OVERLAY(?PR?DHCPC_ROUTINE?DHCPC                   ~  ?PR?_?LWPS_DHCPC_RECVFROM?DHCPC,
        ?PR?_?UDP_HANDLER_RECVFROM_FUNC?LWPS_API   !  ?PR?_?LWPS_DHCPC_RECVFROM?DHCPC)

;SNMP OVERLAY
OVERLAY(?PR?SNMP_INIT?MSG_IN                   ~  ?PR?_?SNMP_RECV?MSG_IN,
        ?PR?_?UDP_HANDLER_RECVFROM_FUNC?LWPS_API   !  ?PR?_?SNMP_RECV?MSG_IN)

CLASSES (XDATA (X:0x0-X:0xBFFF), HDATA (X:0x0-X:0xBFFF))
